{
  "ReverseProxy": {
    "Routes": {
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/orders/{**catch-all}" }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/{**catch-all}" }
      }
    },
    "Clusters": {
      "order-cluster": {
        "Destinations": {
          "order-api": { "Address": "http://order-api:8080/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-api": { "Address": "http://notification-api:8080/" }
        }
      }
    }
  }
}
